{
  "name": "shiqizhang",
  "version": "1.0.0",
  "description": "士气章设计工具",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win portable",
    "electron:build:win": "vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder",
    "electron:build:dir": "vite build && electron-builder --win dir",
    "pack": "vite build && electron-packager . shiqizhang --platform=win32 --arch=x64 --out=dist-pack --overwrite --icon=build/icon.ico --app-version=1.0.0 --ignore=\"(^/src$|^/src/)\" --ignore=\"(^/dist-pack)\" --ignore=\"(^/dist-electron)\" --ignore=\"(^/\\.git)\" --prune=true"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.rhoxane.shiqizhang",
    "productName": "蚀刻章设计工具",
    "copyright": "Copyright © 2025 Rhoxane",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "forceCodeSigning": false,
    "portable": {
      "artifactName": "蚀刻章设计工具-${version}-便携版.exe"
    }
  },
  "author": "Rhoxane"
}